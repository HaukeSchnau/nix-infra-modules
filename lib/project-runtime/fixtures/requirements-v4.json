{
  "schemaVersion": 4,
  "project": "requirements-fixture",
  "requirements": {
    "database": {
      "kind": "postgresql",
      "majorVersions": [
        16,
        17
      ]
    },
    "uploads": {
      "kind": "directory"
    },
    "session": {
      "kind": "secret",
      "generate": {
        "bytes": 32
      }
    }
  },
  "parameters": {
    "optional": {
      "type": "string",
      "required": false
    }
  },
  "environment": {
    "development": {
      "common": {
        "DATABASE_URL": {
          "binding": "database",
          "field": "url"
        },
        "UPLOADS": {
          "binding": "uploads",
          "field": "path"
        },
        "TOKEN": {
          "binding": "session",
          "field": "value"
        },
        "INSTANCE_ID": {
          "instance": "id"
        },
        "OPTIONAL": {
          "parameter": "optional"
        },
        "LITERAL": "quotes ' and $literal `text`\nnext line"
      },
      "actions": {
        "web": {
          "WEB_PORT": {
            "endpoint": "web",
            "field": "listen.port"
          }
        }
      }
    },
    "release": {
      "common": {
        "DATABASE_URL": {
          "binding": "database",
          "field": "url"
        },
        "UPLOADS": {
          "binding": "uploads",
          "field": "path"
        },
        "TOKEN": {
          "binding": "session",
          "field": "value"
        },
        "INSTANCE_ID": {
          "instance": "id"
        },
        "OPTIONAL": {
          "parameter": "optional"
        },
        "LITERAL": "quotes ' and $literal `text`\nnext line"
      },
      "actions": {
        "web": {
          "WEB_PORT": {
            "endpoint": "web",
            "field": "listen.port"
          }
        }
      }
    }
  },
  "development": {
    "workloads": {
      "web": {},
      "database": {}
    },
    "providers": {
      "database": {
        "workload": "database"
      }
    },
    "endpoints": {
      "web": {
        "port": 3000
      }
    }
  },
  "release": {
    "action": "web"
  }
}
