{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HaukeSchnau/nix-infra-modules/main/schemas/project-descriptor/v4.json",
  "title": "Project Descriptor v4",
  "type": "object",
  "required": [
    "schemaVersion",
    "project"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "const": 4
    },
    "project": {
      "$ref": "#/$defs/name"
    },
    "secrets": {
      "type": "object"
    },
    "parameters": {
      "type": "object"
    },
    "development": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "preparation": {
          "type": "object"
        },
        "workloads": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/workload"
          }
        },
        "commands": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/developmentCommand"
          }
        },
        "endpoints": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "providers": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "workload": {
                "$ref": "#/$defs/name"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "database": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$",
                "not": {
                  "enum": [
                    ".",
                    ".."
                  ]
                }
              },
              "user": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$",
                "not": {
                  "enum": [
                    ".",
                    ".."
                  ]
                }
              },
              "majorVersion": {
                "type": "integer",
                "minimum": 10
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "activationExecutable": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "enum": [
            "service",
            "static"
          ]
        },
        "commands": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/releaseCommand"
          }
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "health": {
          "$ref": "#/$defs/httpHealth"
        },
        "ingress": {
          "type": "object"
        },
        "maintenanceJobs": {
          "type": "object"
        },
        "ociAuxiliaries": {
          "type": "object"
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "preDeployTasks": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/releaseTask"
          }
        },
        "stateDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$",
        "not": {
          "enum": [
            ".",
            ".."
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/requirement"
      }
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "development",
          "release"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "common": {
            "$ref": "#/$defs/environmentMap"
          },
          "actions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/environmentMap"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "releaseCommand": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "secrets": {
          "$ref": "#/$defs/secrets"
        }
      },
      "additionalProperties": false
    },
    "developmentCommand": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "secrets": {
          "$ref": "#/$defs/secrets"
        }
      },
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "kind": {
          "enum": [
            "service",
            "task"
          ]
        },
        "lifecycle": {
          "enum": [
            "background",
            "on-demand"
          ]
        },
        "secrets": {
          "$ref": "#/$defs/secrets"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "background"
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "service"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "releaseTask": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "failureMode": {
          "enum": [
            "fail",
            "defer"
          ]
        },
        "secrets": {
          "$ref": "#/$defs/secrets"
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "httpHealth": {
      "type": "object",
      "properties": {
        "intervalSec": {
          "type": "integer",
          "minimum": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "requestTimeoutSec": {
          "type": "integer",
          "minimum": 1
        },
        "startupTimeoutSec": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "tcpHealth": {
      "type": "object",
      "properties": {
        "intervalSec": {
          "type": "integer",
          "minimum": 1
        },
        "requestTimeoutSec": {
          "type": "integer",
          "minimum": 1
        },
        "startupTimeoutSec": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "protocol": {
          "enum": [
            "http",
            "tcp"
          ]
        },
        "workload": {
          "$ref": "#/$defs/name"
        },
        "health": {
          "type": "object"
        },
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "publication": {
          "enum": [
            "private",
            "preview"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "tcp"
              }
            },
            "required": [
              "protocol"
            ]
          },
          "then": {
            "properties": {
              "health": {
                "$ref": "#/$defs/tcpHealth"
              }
            }
          },
          "else": {
            "properties": {
              "health": {
                "$ref": "#/$defs/httpHealth"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "requirement": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "postgresql"
            },
            "description": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "realizations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "development",
                  "release"
                ]
              }
            },
            "majorVersion": {
              "type": "integer",
              "minimum": 10
            },
            "dataDirectory": {
              "type": "string",
              "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$"
            },
            "majorVersions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 10
              }
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "majorVersion"
              ]
            },
            {
              "required": [
                "majorVersions"
              ]
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "directory"
            },
            "description": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "realizations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "development",
                  "release"
                ]
              }
            },
            "path": {
              "type": "string",
              "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$"
            },
            "persistent": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "secret"
            },
            "description": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "realizations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "development",
                  "release"
                ]
              }
            },
            "generate": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 16,
                  "maximum": 1024
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "environmentValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "binding",
            "field"
          ],
          "properties": {
            "binding": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$",
              "not": {
                "enum": [
                  ".",
                  ".."
                ]
              }
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "endpoint",
            "field"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$",
              "not": {
                "enum": [
                  ".",
                  ".."
                ]
              }
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "parameter"
          ],
          "properties": {
            "parameter": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$",
              "not": {
                "enum": [
                  ".",
                  ".."
                ]
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "enum": [
                "checkout",
                "state",
                "cache",
                "runtime"
              ]
            },
            "append": {
              "type": "string",
              "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "secret"
          ],
          "properties": {
            "secret": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$",
              "not": {
                "enum": [
                  ".",
                  ".."
                ]
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "instance"
          ],
          "properties": {
            "instance": {
              "const": "id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "environmentMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/environmentValue"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "development"
      ],
      "properties": {
        "development": {
          "type": "object"
        }
      }
    },
    {
      "required": [
        "release"
      ],
      "properties": {
        "release": {
          "type": "object"
        }
      }
    }
  ]
}
